	(text "USB 2.0 Full-Speed (12 Mbps)\nUART Data transfer rates from 300 baud to 3 Mbaud at TTL levels"
		(exclude_from_sim no)
		(at 25.654 69.342 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left)
		)
		(uuid "196469e7-8d69-43ce-88b1-988a3f011867")
	)
	(text "Shield referenced to GND \nvia ferrite (HF only, no DC bond)"
		(exclude_from_sim no)
		(at 149.352 115.062 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "36934773-fca1-4bac-9b5f-832d8cf9bca5")
	)
	(text "FT230XS USB↔UART Bridge"
		(exclude_from_sim no)
		(at 24.892 65.024 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.3556)
				(bold yes)
				(italic yes)
			)
			(justify left)
		)
		(uuid "93a04a19-1abb-4aa1-adbb-0196dec09ef1")
	)
	(text_box "Function Summary :\n- Converts USB 2.0 Full-Speed signaling to asynchronous UART\n- Enumerates as a virtual COM port on the host (FTDI VCP)\n- Provides TXD / RXD UART interface at 3.3 V logic\n- USB engine + clock fully integrated (no crystal required)\n- 3.3 V regulator onboard (3V3OUT), VCCIO externally selectable (3.3 V in your design)\n- Supports CBUS programmable pins:\n	- CBUS1 = TXLED#\n	- CBUS2 = RXLED#\n	- CBUS0/3 = connector"
		(exclude_from_sim no)
		(at 24.13 72.39 0)
		(size 77.47 24.13)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left top)
		)
		(uuid "980ee292-4c9b-4179-a0fb-593c8402b9f2")
	)
	(text_box "VBUS Protection & Filtering :\n- PTC Fuse: 1206L035YR / 1206L050YR  (I_hold 0.35A / 0.50A, 1206 footprint)\n- TVS VBUS: SMAJ15CA, bidirectional (SMA / DO-214AC package)\n- VBUS EMI Filter: BLM18KG601SN1D (600Ω @100MHz, 0603)\n- Decoupling: 10µF + 100nF (placed immediately after ferrite)\n\nUSB Data Lines (D+ / D−)\n- Common-Mode Choke: 744232090 (Würth Elektronik)\n- High-Speed ESD Array: WE-TVS-82400102\n- Series Termination: 27Ω on D+ and D− (matched pair)\n\nUSB Shield\n- Shield → GND via BLM18KG601SN1D (same ferrite as VBUS, 600Ω @100MHz)"
		(exclude_from_sim no)
		(at 24.13 96.52 0)
		(size 77.47 41.91)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ae96e83b-68e8-490e-894d-543afeee7b89")
	)
